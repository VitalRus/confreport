---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About - ${SITE_TITLE}`} description="About Conflict Report, editorial standards, and intelligence methodologies." />
		<style>
			main {
				width: 820px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
				color: #334155;
				line-height: 1.7;
			}
			h1 { color: #0f172a; font-size: 2.2em; margin-bottom: 0.4em; }
			h2 { color: #0f172a; font-size: 1.4em; margin-top: 1.8em; }
			p { margin-bottom: 1.2em; }
			ul { margin-bottom: 1.2em; padding-left: 1.5em; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>About Conflict Report</h1>
			<p><strong>Conflict Report</strong> is an independent analytical publication tracking security infrastructure, geopolitical shifts, maritime logistics, and strategic energy corridors.</p>

			<h2>Our Methodology</h2>
			<p>We operate on rigorous open-source intelligence (OSINT) verification, satellite mapping cross-referencing, and trade flow data tracking. Our objective is to deliver clear, noise-free strategic assessments without sensationalism or political bias.</p>

			<h2>Coverage Pillars</h2>
			<ul>
				<li><strong>Critical Energy Infrastructure:</strong> Refining capacities, pipeline networks, and domestic fuel supply chains.</li>
				<li><strong>Maritime Security:</strong> Commercial corridors across the Black Sea, Mediterranean, and Indo-Pacific choke points.</li>
				<li><strong>Tactical Assessments:</strong> Defense logistics, air defense saturation, and regional procurement pivots.</li>
			</ul>

			<h2>Editorial Independence</h2>
			<p>Conflict Report is privately operated, ensuring neutral reporting driven exclusively by verifiable data and strategic outcomes.</p>
		</main>
		<Footer />
	</body>
</html>
