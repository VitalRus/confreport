---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1100px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em;
			}
			.hero-section {
				padding: 4em 2em;
				text-align: center;
				background: #0f172a;
				color: #f8fafc;
				border-radius: 12px;
				margin-bottom: 3.5em;
			}
			.hero-section h1 {
				color: #ffffff;
				font-size: 2.8em;
				font-weight: 800;
				margin-bottom: 0.4em;
				line-height: 1.15;
				letter-spacing: -0.02em;
			}
			.hero-section p {
				color: #94a3b8;
				font-size: 1.15em;
				max-width: 650px;
				margin: 0 auto;
				line-height: 1.6;
			}
			.editorial-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				gap: 2em;
				list-style-type: none;
				padding: 0;
				margin: 0;
			}
			.editorial-card {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 10px;
				overflow: hidden;
				display: flex;
				flex-direction: column;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.editorial-card:hover {
				transform: translateY(-4px);
				box-shadow: 0 12px 20px -5px rgba(15, 23, 42, 0.08);
			}
			.card-img-wrapper {
				display: block;
				width: 100%;
				height: 200px;
				background: #f1f5f9;
				overflow: hidden;
			}
			.card-img-wrapper img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.card-body {
				padding: 1.5em;
				display: flex;
				flex-direction: column;
				flex-grow: 1;
			}
			.card-date {
				font-size: 0.85em;
				color: #64748b;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-bottom: 0.5em;
			}
			.card-body h3 {
				margin: 0 0 0.6em 0;
				font-size: 1.25em;
				font-weight: 700;
				line-height: 1.35;
			}
			.card-body h3 a {
				color: #0f172a;
				text-decoration: none;
			}
			.card-body h3 a:hover {
				color: #2563eb;
			}
			.card-body p {
				color: #475569;
				font-size: 0.95em;
				line-height: 1.55;
				flex-grow: 1;
				margin: 0 0 1.2em 0;
			}
			.section-title {
				font-size: 1.6em;
				font-weight: 700;
				color: #0f172a;
				border-bottom: 2px solid #e2e8f0;
				padding-bottom: 0.6em;
				margin-bottom: 1.8em;
				letter-spacing: -0.01em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero-section">
				<h1>Independent Strategic Analysis</h1>
				<p>Objective reporting, tactical tracking, and analytical breakdowns across active conflict zones, security corridors, and global energy dynamics.</p>
			</div>

			<h2 class="section-title">Latest Reports & Briefings</h2>

			<ul class="editorial-grid">
				{
					posts.map((post) => (
						<li class="editorial-card">
							<a href={`/blog/${post.slug}/`} class="card-img-wrapper">
								{post.data.heroImage && (
									<Image 
										width={600} 
										height={340} 
										src={post.data.heroImage} 
										alt={post.data.title} 
									/>
								)}
							</a>
							<div class="card-body">
								<span class="card-date">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
								<h3><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h3>
								<p>{post.data.description}</p>
							</div>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
