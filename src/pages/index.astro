---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1040px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2em 1em 4em 1em;
			}
			.hero {
				background: #0f172a;
				color: #ffffff;
				padding: 3.5em 2em;
				border-radius: 12px;
				text-align: center;
				margin-bottom: 3em;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
			}
			.hero h1 {
				font-size: 2.6em;
				margin: 0 0 0.4em 0;
				color: #ffffff;
				letter-spacing: -0.02em;
			}
			.hero p {
				font-size: 1.15em;
				color: #94a3b8;
				max-width: 680px;
				margin: auto;
				line-height: 1.6;
			}
			.section-title {
				font-size: 1.6em;
				color: #0f172a;
				margin-bottom: 1.2em;
				border-bottom: 2px solid #e2e8f0;
				padding-bottom: 0.4em;
			}
			.articles-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 2em;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.article-card {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 10px;
				overflow: hidden;
				display: flex;
				flex-direction: column;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.article-card:hover {
				transform: translateY(-3px);
				box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
			}
			.article-card a {
				text-decoration: none;
				color: inherit;
				display: flex;
				flex-direction: column;
				height: 100%;
			}
			.card-image {
				width: 100%;
				height: 180px;
				object-fit: cover;
				background: #0f172a;
			}
			.card-body {
				padding: 1.4em;
				display: flex;
				flex-direction: column;
				flex-grow: 1;
			}
			.card-date {
				font-size: 0.8em;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: #64748b;
				margin-bottom: 0.6em;
			}
			.card-title {
				font-size: 1.2em;
				color: #0f172a;
				margin: 0 0 0.6em 0;
				line-height: 1.35;
			}
			.card-desc {
				font-size: 0.92em;
				color: #475569;
				line-height: 1.55;
				margin: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<h1>Independent Strategic Analysis</h1>
				<p>Objective reporting, tactical tracking, and analytical breakdowns across active conflict zones, security corridors, and global energy dynamics.</p>
			</div>

			<h2 class="section-title">Latest Reports & Briefings</h2>

			<ul class="articles-grid">
				{
					posts.map((post) => (
						<li class="article-card">
							<a href={`/blog/${post.slug || post.id}/`}>
								{post.data.heroImage && (
									<img class="card-image" src={post.data.heroImage} alt={post.data.title} />
								)}
								<div class="card-body">
									<div class="card-date">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h3 class="card-title">{post.data.title}</h3>
									<p class="card-desc">{post.data.description}</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
